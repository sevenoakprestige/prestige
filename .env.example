API_KEY=your_api_key
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=your_google_tag_manager_id
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=your_sanity_dataset
SANITY_REVALIDATE_SECRET=your_sanity_revalidate_secret

# ─── Zoho SMTP ───────────────────────────────────────────────────────────────
# For custom-domain accounts (Paid org, e.g. contact@yourdomain.com):
#   Host: smtppro.zoho.com  (global) OR smtppro.zoho.eu  (EU datacenter)
# For personal @zohomail.com accounts:
#   Host: smtp.zoho.com
# Port: 465, SSL. Use an App-Specific Password if 2FA is enabled.
# Generate at: accounts.zoho.com → Security → App Passwords
ZOHO_SMTP_HOST="smtppro.zoho.com"
ZOHO_SMTP_USER="contact@sevenoakprestige.com"
ZOHO_SMTP_PASS="your_app_specific_password_here"

